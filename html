<script>
/* ══════════════════════════════════════════════════════════
   HWPX 생성기 (브라우저·무의존)
   - 마크다운 문서 → OWPML(section0.xml) 변환
   - 정적 파트(header/settings/manifest 등)는 검증된 정본을 그대로 사용
   - ZIP은 무압축(STORE)으로 기록 → 압축 라이브러리 불필요
   ══════════════════════════════════════════════════════════ */

/* 스타일 ID 매핑 (정본 header.xml 기준)
   charPr  6=본문11pt  7=제목20pt  9=소제목14pt  11=굵게11pt
   paraPr 21=제목1  22=본문  24=제목2  25=불릿  23=표머리  0=표본문
   style   0=바탕글  2=개요1  3=개요2
   borderFill 5=표본문셀  6=표머리셀                                */
var HW = {
  charBody: 6, charTitle: 7, charHead: 9, charBold: 11,
  paraTitle: 21, paraBody: 22, paraHead2: 24, paraBullet: 25,
  paraCellHead: 23, paraCellBody: 0,
  styleBody: 0, styleH1: 2, styleH2: 3,
  bfCellHead: 6, bfCellBody: 5,
  tblWidth: 45000, rowHeight: 3600
};

function hwEsc(s) {
  return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;")
                  .replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}
function hwRid() { return Math.floor(Math.random() * 2000000000); }

/* **굵게** 를 별도 run 으로 분리 */
function hwRuns(text, baseCharPr) {
  var segs = String(text).split(/\*\*(.+?)\*\*/g), out = "";
  for (var i = 0; i < segs.length; i++) {
    if (!segs[i]) continue;
    var cp = (i % 2 === 1) ? HW.charBold : baseCharPr;
    out += '<hp:run charPrIDRef="' + cp + '"><hp:t>' + hwEsc(segs[i]) + "</hp:t></hp:run>";
  }
  if (!out) out = '<hp:run charPrIDRef="' + baseCharPr + '"><hp:t></hp:t></hp:run>';
  return out;
}
function hwPara(text, paraPr, styleId, charPr) {
  return '<hp:p id="' + hwRid() + '" paraPrIDRef="' + paraPr + '" styleIDRef="' + styleId +
         '" pageBreak="0" columnBreak="0" merged="0">' + hwRuns(text, charPr) + "</hp:p>";
}

/* 표 셀 하나 */
function hwCell(text, col, row, cw, isHead) {
  var bf = isHead ? HW.bfCellHead : HW.bfCellBody;
  var pp = isHead ? HW.paraCellHead : HW.paraCellBody;
  var cp = isHead ? HW.charBold : HW.charBody;
  return '<hp:tc name="" header="' + (isHead ? 1 : 0) + '" hasMargin="1" protect="0" editable="0" dirty="0" borderFillIDRef="' + bf + '">' +
    '<hp:subList id="" textDirection="HORIZONTAL" lineWrap="BREAK" vertAlign="CENTER" linkListIDRef="0" linkListNextIDRef="0" textWidth="0" textHeight="0" hasTextRef="0" hasNumRef="0">' +
    '<hp:p paraPrIDRef="' + pp + '" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0" id="' + hwRid() + '">' +
    hwRuns(text, cp) + "</hp:p></hp:subList>" +
    '<hp:cellAddr colAddr="' + col + '" rowAddr="' + row + '"/>' +
    '<hp:cellSpan colSpan="1" rowSpan="1"/>' +
    '<hp:cellSz width="' + cw + '" height="' + HW.rowHeight + '"/>' +
    '<hp:cellMargin left="425" right="425" top="425" bottom="425"/></hp:tc>';
}

/* 표 전체 (문단으로 감싸서 반환) */
function hwTable(rows, hasHeader) {
  var colCnt = 1;
  rows.forEach(function (r) { if (r.length > colCnt) colCnt = r.length; });
  var rowCnt = rows.length;
  var cw = Math.floor(HW.tblWidth / colCnt);
  var body = "";
  for (var r = 0; r < rowCnt; r++) {
    body += "<hp:tr>";
    for (var c = 0; c < colCnt; c++) {
      body += hwCell(rows[r][c] === undefined ? "" : rows[r][c], c, r, cw, hasHeader && r === 0);
    }
    body += "</hp:tr>";
  }
  var tbl = '<hp:tbl id="' + hwRid() + '" zOrder="0" numberingType="TABLE" textWrap="TOP_AND_BOTTOM" textFlow="BOTH_SIDES" lock="0" dropcapstyle="None" pageBreak="CELL" repeatHeader="' + (hasHeader ? 1 : 0) + '" rowCnt="' + rowCnt + '" colCnt="' + colCnt + '" cellSpacing="0" borderFillIDRef="' + HW.bfCellBody + '" noAdjust="0">' +
    '<hp:sz width="' + (cw * colCnt) + '" widthRelTo="ABSOLUTE" height="' + (HW.rowHeight * rowCnt) + '" heightRelTo="ABSOLUTE" protect="0"/>' +
    '<hp:pos treatAsChar="1" affectLSpacing="0" flowWithText="1" allowOverlap="0" holdAnchorAndSO="0" vertRelTo="PARA" horzRelTo="COLUMN" vertAlign="TOP" horzAlign="LEFT" vertOffset="0" horzOffset="0"/>' +
    '<hp:outMargin left="0" right="0" top="0" bottom="0"/><hp:inMargin left="0" right="0" top="0" bottom="0"/>' +
    body + "</hp:tbl>";
  return '<hp:p id="' + hwRid() + '" paraPrIDRef="' + HW.paraBody + '" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0">' +
         '<hp:run charPrIDRef="' + HW.charBody + '">' + tbl + "</hp:run></hp:p>";
}

/* 마크다운 → OWPML 본문 */
function mdToHwpxBody(md) {
  var lines = String(md || "").split("\n"), out = "", i = 0;
  while (i < lines.length) {
    var line = lines[i];

    /* 표 */
    if (/^\s*\|.*\|\s*$/.test(line)) {
      var raw = [];
      while (i < lines.length && /^\s*\|.*\|\s*$/.test(lines[i])) { raw.push(lines[i]); i++; }
      var cells = raw.map(function (r) {
        return r.trim().replace(/^\||\|$/g, "").split("|").map(function (c) { return c.trim(); });
      });
      var isSep = function (row) { return row.length && row.every(function (c) { return /^:?-+:?$/.test(c); }); };
      var hasHeader = cells.length > 1 && isSep(cells[1]);
      cells = cells.filter(function (row) { return !isSep(row); });
      if (cells.length) out += hwTable(cells, hasHeader);
      continue;
    }

    /* 제목 */
    var h = line.match(/^(#{1,4})\s+(.*)/);
    if (h) {
      if (h[1].length <= 1) out += hwPara(h[2], HW.paraTitle, HW.styleH1, HW.charTitle);
      else if (h[1].length === 2) out += hwPara(h[2], HW.paraTitle, HW.styleH1, HW.charHead);
      else out += hwPara(h[2], HW.paraHead2, HW.styleH2, HW.charHead);
      i++; continue;
    }

    /* 불릿 */
    var b = line.match(/^\s*[-•*]\s+(.*)/);
    if (b) { out += hwPara("• " + b[1], HW.paraBullet, HW.styleBody, HW.charBody); i++; continue; }

    /* 빈 줄 · 일반 문단 */
    out += hwPara(line.trim(), HW.paraBody, HW.styleBody, HW.charBody);
    i++;
  }
  if (!out) out = hwPara("", HW.paraBody, HW.styleBody, HW.charBody);
  return out;
}

/* ── 순수 JS ZIP(STORE) 작성기 ── */
var CRC_TABLE = (function () {
  var t = new Uint32Array(256);
  for (var n = 0; n < 256; n++) {
    var c = n;
    for (var k = 0; k < 8; k++) c = (c & 1) ? (0xEDB88320 ^ (c >>> 1)) : (c >>> 1);
    t[n] = c >>> 0;
  }
  return t;
})();
function crc32(buf) {
  var c = 0xFFFFFFFF;
  for (var i = 0; i < buf.length; i++) c = CRC_TABLE[(c ^ buf[i]) & 0xFF] ^ (c >>> 8);
  return (c ^ 0xFFFFFFFF) >>> 0;
}
function utf8(str) {
  if (typeof TextEncoder !== "undefined") return new TextEncoder().encode(str);
  var s = unescape(encodeURIComponent(str)), a = new Uint8Array(s.length);
  for (var i = 0; i < s.length; i++) a[i] = s.charCodeAt(i);
  return a;
}
function zipStore(entries) {
  var chunks = [], central = [], offset = 0;
  function u16(v) { return [v & 0xFF, (v >>> 8) & 0xFF]; }
  function u32(v) { return [v & 0xFF, (v >>> 8) & 0xFF, (v >>> 16) & 0xFF, (v >>> 24) & 0xFF]; }

  entries.forEach(function (e) {
    var name = utf8(e.name), data = utf8(e.data), crc = crc32(data);
    var local = [].concat(u32(0x04034b50), u16(20), u16(0), u16(0), u16(0), u16(0),
      u32(crc), u32(data.length), u32(data.length), u16(name.length), u16(0));
    chunks.push(new Uint8Array(local), name, data);
    central.push({ name: name, crc: crc, size: data.length, offset: offset });
    offset += local.length + name.length + data.length;
  });

  var cdir = [], cdirSize = 0;
  central.forEach(function (c) {
    var head = [].concat(u32(0x02014b50), u16(20), u16(20), u16(0), u16(0), u16(0), u16(0),
      u32(c.crc), u32(c.size), u32(c.size), u16(c.name.length),
      u16(0), u16(0), u16(0), u16(0), u32(0), u32(c.offset));
    cdir.push(new Uint8Array(head), c.name);
