/* ── Markdown → HTML (표/제목/불릿/굵게) ── */
function esc(t){ return t.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function inlineMd(t){ return esc(t).replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>'); }
function renderTable(rows){
  var cells = rows.map(function(r){
    return r.trim().replace(/^\||\|$/g,'').split('|').map(function(c){ return c.trim(); });
  });
  var isSep = function(row){ return row.length && row.every(function(c){ return /^:?-+:?$/.test(c); }); };
  var hasSep = cells.some(isSep), headerDone = false;
  var out = '<table>';
  cells.forEach(function(row){
    if (isSep(row)) { headerDone = true; return; }
    var th = hasSep && !headerDone;
    out += '<tr>' + row.map(function(c){
      var tag = th ? 'th' : 'td';
      return '<' + tag + '>' + inlineMd(c) + '</' + tag + '>';
    }).join('') + '</tr>';
  });
  return out + '</table>';
}
function mdToHtml(md){
  var lines = (md || '').split('\n'), html = '', i = 0, inList = false;
  function closeList(){ if (inList) { html += '</ul>'; inList = false; } }
  while (i < lines.length){
    var line = lines[i];
    if (/^\s*\|.*\|\s*$/.test(line)){
      closeList();
      var rows = [];
      while (i < lines.length && /^\s*\|.*\|\s*$/.test(lines[i])) { rows.push(lines[i]); i++; }
      html += renderTable(rows); continue;
    }
    var h = line.match(/^(#{1,4})\s+(.*)/);
    if (h){ closeList(); var lv = Math.min(h[1].length + 1, 5);
      html += '<h' + lv + ' style="margin:14px 0 6px;font-size:' + (17 - h[1].length) + 'px">' + inlineMd(h[2]) + '</h' + lv + '>';
      i++; continue; }
    var b = line.match(/^\s*[-•]\s+(.*)/);
    if (b){ if (!inList){ html += '<ul style="margin:4px 0 4px 18px;padding:0">'; inList = true; }
      html += '<li style="margin:2px 0">' + inlineMd(b[1]) + '</li>'; i++; continue; }
    if (line.trim() === ''){ closeList(); i++; continue; }
    closeList(); html += '<p style="margin:4px 0">' + inlineMd(line) + '</p>'; i++;
  }
  closeList();
  return html;
}

