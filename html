function tryPin(){
  if ($('pinInput').value === pinCode){ $('pinInput').value = ''; showErr(''); setAdmin(true); }
  else { $('pinInput').value = ''; alert('PIN이 올바르지 않습니다.'); }
}
$('cfgSave').addEventListener('click', function(){
  cfg.apiUrl = $('apiUrl').value.trim();
  var np = $('pinChange').value.trim();
  if (np){ pinCode = np; localStorage.setItem(LS_PIN, np); $('pinChange').value = ''; }
  flashSave(saveCfg() ? '저장됨 ✓' + (np ? ' (PIN 변경됨)' : '') : '저장 실패 — 브라우저 설정을 확인하세요');
});
$('cfgReset').addEventListener('click', function(){
  if (!confirm('모든 프롬프트를 기본값으로 되돌릴까요?')) return;
  cfg = Object.assign({}, DEFAULT_CFG);
  renderCfgFields();
  flashSave('기본값으로 되돌림 — 저장하려면 ‘설정 저장’');
});
